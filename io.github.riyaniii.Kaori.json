{
    "id": "io.github.riyaniii.Kaori",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.openjdk21"
    ],
    "command": "kaori",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--env=PATH=/app/jre/bin:/app/bin:/usr/bin"
    ],
    "modules": [
        "python3-requirements.json",
        {
            "name": "openjdk",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/openjdk21/install.sh"
            ]
        },
        {
            "name": "kaori",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/riyaniii/Kaori/archive/refs/tags/0.9.7.tar.gz",
                    "sha256": "4505c8774d61f5135bc496ff1bf88560dd9270ace3b195839312761bbc351f18"
                }
            ]
        }
    ]
}
