{
    "id": "io.github.riyaniii.Kaori",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.openjdk21"
    ],
    "command": "kaori",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--env=PATH=/app/jre/bin:/app/bin:/usr/bin"
    ],
    "modules": [
        "python3-requirements.json",
        {
            "name": "openjdk",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/openjdk21/install.sh"
            ]
        },
        {
            "name": "kaori",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/riyaniii/Kaori.git",
                    "tag": "0.9.8",
                    "commit": "273a440c13ca18e5c937e7de65c48129d1d9b197"
                }
            ]
        }
    ]
}
